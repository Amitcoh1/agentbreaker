# Absolute URL of the dashboard app (the other Vercel project). Used for the cross-domain
# "Open builder" link. Falls back to a relative /dashboard/builder path if unset.
NEXT_PUBLIC_APP_URL=https://app.YOUR_DOMAIN

# Absolute URL of the docs app (cloud/docs, its own Vercel project). Used for the nav "Docs" link.
NEXT_PUBLIC_DOCS_URL=https://docs.YOUR_DOMAIN

# Canonical marketing site URL (for metadataBase / OG tags).
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN
