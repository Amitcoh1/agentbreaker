# Public (browser-safe) — anon key; RLS restricts reads to public runs.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Control edge function URL (for the Pause/Kill buttons). Issuing a command also needs the
# CONTROL_KEY, which the operator types into the dashboard UI (kept in localStorage only).
NEXT_PUBLIC_CONTROL_URL=https://YOUR_PROJECT.functions.supabase.co/control
