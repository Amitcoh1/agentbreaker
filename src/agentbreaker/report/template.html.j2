<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AgentBreaker receipt — {{ r.run_id[:8] }}</title>
<style>
 :root{--bg:#0e1116;--card:#171b22;--fg:#e6edf3;--muted:#8b949e;--good:#2ea043;--bad:#f85149;--accent:#58a6ff;--line:#222831}
 *{box-sizing:border-box}
 body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
 .wrap{max-width:820px;margin:0 auto;padding:32px}
 .head{display:flex;justify-content:space-between;align-items:baseline;gap:16px}
 h1{font-size:18px;margin:0;font-weight:600}
 .status{padding:3px 10px;border-radius:999px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.04em}
 .s-completed{background:rgba(46,160,67,.15);color:var(--good)}
 .s-killed,.s-paused,.s-unknown{background:rgba(248,81,73,.15);color:var(--bad)}
 .headline{margin:24px 0;padding:28px 24px;background:var(--card);border-radius:12px;text-align:center}
 .big{font-size:40px;font-weight:700;letter-spacing:-1px}
 .proj{color:var(--muted);text-decoration:line-through}
 .stop{color:var(--good)}
 .headline.killed .stop,.headline.paused .stop{color:var(--accent)}
 .sub{color:var(--muted);font-size:13px;margin-top:8px}
 .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0}
 .metric{background:var(--card);border-radius:10px;padding:14px}
 .metric .k{color:var(--muted);font-size:12px}
 .metric .v{font-size:20px;font-weight:600;margin-top:2px}
 svg{width:100%;height:90px;display:block;margin:8px 0 4px}
 table{width:100%;border-collapse:collapse;margin-top:8px;font-size:13px}
 th,td{text-align:left;padding:7px 8px;border-bottom:1px solid var(--line)}
 th{color:var(--muted);font-weight:500}
 td.num{text-align:right;font-variant-numeric:tabular-nums}
 .bar{height:6px;background:var(--accent);border-radius:3px;min-width:1px}
 .tool{color:var(--muted)}
 .se{color:var(--bad);font-weight:600}
 .warn{color:#d29922;font-size:12px}
 .foot{color:var(--muted);font-size:12px;margin-top:24px}
</style></head>
<body><div class="wrap">
 <div class="head">
   <h1>AgentBreaker receipt</h1>
   <span class="status s-{{ r.status }}">{{ r.status }}{% if r.trip_reason %} · {{ r.trip_reason }}{% endif %}</span>
 </div>

 <div class="headline {{ r.status }}">
   <div class="big"><span class="proj">{{ r.projected_disp }}</span> &nbsp;→&nbsp; <span class="stop">{{ r.spent_disp }}</span></div>
   <div class="sub">Projected uncapped (mean cost/hop × {{ r.max_hops }} hop ceiling) vs. actually spent</div>
 </div>

 <div class="grid">
   <div class="metric"><div class="k">Spent</div><div class="v">{{ r.spent_disp }}</div></div>
   <div class="metric"><div class="k">Budget</div><div class="v">{{ r.budget_disp }}</div></div>
   <div class="metric"><div class="k">Hops</div><div class="v">{{ r.hops }}</div></div>
   <div class="metric"><div class="k">Saved</div><div class="v">{{ r.saved_disp }}</div></div>
 </div>

 <svg viewBox="0 0 640 90" preserveAspectRatio="none" aria-label="cumulative cost">
   <polyline fill="none" stroke="#58a6ff" stroke-width="2" points="{{ spark_points }}"/>
 </svg>

 {% if r.side_effects_fired %}
 <p class="se">⚠ Side-effecting tools fired before the trip: {{ r.side_effects_fired|join(', ') }}</p>
 {% endif %}

 <table>
   <thead><tr>
     <th>#</th><th>node</th><th>model</th>
     <th class="num">in</th><th class="num">out</th>
     <th class="num">cost</th><th class="num">cumulative</th><th>&nbsp;</th>
   </tr></thead>
   <tbody>
   {% for t in r.timeline %}
     <tr>
       <td>{{ loop.index }}</td>
       <td>{{ t.node }}{% if t.side_effecting %} <span class="se">side-effect</span>{% endif %}</td>
       <td class="{{ 'tool' if t.kind == 'tool' else '' }}">{{ t.model or t.kind }}</td>
       <td class="num">{{ t.tokens_in or '' }}</td>
       <td class="num">{{ t.tokens_out or '' }}</td>
       <td class="num">${{ '%.4f'|format(t.actual_usd) }}</td>
       <td class="num">${{ '%.4f'|format(t.cumulative_usd) }}</td>
       <td><div class="bar" style="width:{{ t.bar_pct }}%"></div></td>
     </tr>
     {% if t.discrepancy %}
     <tr><td></td><td colspan="7" class="warn">↳ meter discrepancy vs provider: {{ t.discrepancy }}</td></tr>
     {% endif %}
   {% endfor %}
   </tbody>
 </table>

 <p class="foot">run {{ r.run_id }} · generated by AgentBreaker · projection = mean cost/hop × max_hops, a conservative lower bound on a true runaway.</p>
</div></body></html>
