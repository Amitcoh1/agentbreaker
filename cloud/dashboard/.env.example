# Public (browser-safe) — anon key. Also used by Supabase Auth (login) and cookie-based RLS:
# reads return your own runs plus any public (shareable) runs.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Control edge function URL (for the Pause/Kill buttons). Owners are authorized by their session; a
# CONTROL_KEY (typed into the dashboard, localStorage only) is an optional fallback for runs you
# don't own.
NEXT_PUBLIC_CONTROL_URL=https://YOUR_PROJECT.functions.supabase.co/control
