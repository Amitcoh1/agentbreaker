<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Breakerbox receipt — {{ r.run_id[:8] }}</title>
<style>
 :root{--bg:#faf9f5;--card:#f3f1ea;--fg:#1f2328;--muted:#6b7280;--ink:#1f2328;--brass:#b8860b;--line:#e6e3da}
 *{box-sizing:border-box}
 body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
 .wrap{max-width:820px;margin:0 auto;padding:32px}
 .head{display:flex;justify-content:space-between;align-items:baseline;gap:16px}
 h1{font-size:18px;margin:0;font-weight:600;letter-spacing:-.01em}
 .status{padding:3px 10px;border-radius:999px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.04em}
 .s-completed{background:rgba(31,35,40,.07);color:var(--ink)}
 .s-killed,.s-paused,.s-unknown{background:rgba(184,134,11,.16);color:var(--brass)}
 .headline{margin:24px 0;padding:28px 24px;background:var(--card);border-radius:12px;text-align:center}
 .big{font-size:40px;font-weight:700;letter-spacing:-1px}
 .proj{color:var(--muted);text-decoration:line-through}
 .stop{color:var(--ink)}
 .headline.killed .stop,.headline.paused .stop{color:var(--brass)}
 .sub{color:var(--muted);font-size:13px;margin-top:8px}
 .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0}
 .metric{background:var(--card);border-radius:10px;padding:14px}
 .metric .k{color:var(--muted);font-size:12px}
 .metric .v{font-size:20px;font-weight:600;margin-top:2px}
 svg{width:100%;height:90px;display:block;margin:8px 0 4px}
 table{width:100%;border-collapse:collapse;margin-top:8px;font-size:13px}
 th,td{text-align:left;padding:7px 8px;border-bottom:1px solid var(--line)}
 th{color:var(--muted);font-weight:500}
 td.num{text-align:right;font-variant-numeric:tabular-nums}
 .bar{height:6px;background:var(--muted);border-radius:3px;min-width:1px}
 .tool{color:var(--muted)}
 .se{color:var(--brass);font-weight:600}
 .warn{color:var(--muted);font-size:12px;font-style:italic}
 .tag{display:inline-block;font-size:11px;color:var(--muted);border:1px solid var(--line);border-radius:999px;padding:1px 8px;margin-right:4px}
 .blast{border:1px solid var(--brass);border-radius:8px;padding:10px 14px;margin:14px 0;background:rgba(184,134,11,.06)}
 .blast ul{margin:6px 0 0 0;padding-left:20px}
 .foot{color:var(--muted);font-size:12px;margin-top:24px}
</style></head>
<body><div class="wrap">
 <div class="head">
   <h1>breakerbox receipt</h1>
   <span class="status s-{{ r.status }}">{{ r.status }}{% if r.trip_reason %} · {{ r.trip_reason }}{% endif %}</span>
 </div>
 <div class="sub" style="opacity:.7">audit · run {{ r.run_id[:8] }}{% if r.started_at %} · {{ r.started_at }}{% endif %}</div>

 <div class="headline {{ r.status }}">
   <div class="big">stopped at <span class="stop">{{ r.spent_disp }}</span></div>
   <div class="sub">budget {{ r.budget_disp }} · {{ r.hops }} hops · {{ r.status }}{% if r.trip_reason %} ({{ r.trip_reason }}){% endif %}</div>
   <div class="sub" style="margin-top:6px;opacity:.75">projected (naive linear extrapolation, likely an underestimate for accumulating-context loops): {{ r.projected_disp }}</div>
   {% if r.tags %}<div class="sub" style="margin-top:6px">{% for k, v in r.tags.items() %}<span class="tag">{{ k }}={{ v }}</span> {% endfor %}</div>{% endif %}
 </div>

 <div class="grid">
   <div class="metric"><div class="k">Spent</div><div class="v">{{ r.spent_disp }}</div></div>
   <div class="metric"><div class="k">Budget</div><div class="v">{{ r.budget_disp }}</div></div>
   <div class="metric"><div class="k">Hops</div><div class="v">{{ r.hops }}</div></div>
   <div class="metric"><div class="k">Saved</div><div class="v">{{ r.saved_disp }}</div></div>
 </div>

 <svg viewBox="0 0 640 90" preserveAspectRatio="none" aria-label="cumulative cost">
   <polyline fill="none" stroke="#1f2328" stroke-width="2" points="{{ spark_points }}"/>
 </svg>

 {% if r.side_effects_fired %}
 <div class="blast">
   <p class="se">⚠ Blast radius — these side-effects already hit the world when the run stopped. Verify or compensate:</p>
   <ul>{% for node in r.side_effects_fired %}<li>{{ node }}</li>{% endfor %}</ul>
 </div>
 {% endif %}

 {% if r.has_overshoot %}
 <p class="warn" style="font-weight:600">⚠ {{ r.overshoot_hops }} hop(s): cap enforced one hop late — no max_tokens declared. The reserve under-counted, so the real cost exceeded it; declare max_tokens to stop strictly under budget.</p>
 {% endif %}

 <table>
   <thead><tr>
     <th>#</th><th>node</th><th>model</th>
     <th class="num">in</th><th class="num">out</th>
     <th class="num">cost</th><th class="num">cumulative</th><th>&nbsp;</th>
   </tr></thead>
   <tbody>
   {% for t in r.timeline %}
     <tr>
       <td>{{ loop.index }}</td>
       <td>{{ t.node }}{% if t.side_effecting %} <span class="se">side-effect</span>{% endif %}</td>
       <td class="{{ 'tool' if t.kind == 'tool' else '' }}">{{ t.model or t.kind }}</td>
       <td class="num">{{ t.tokens_in or '' }}</td>
       <td class="num">{{ t.tokens_out or '' }}</td>
       <td class="num">${{ '%.4f'|format(t.actual_usd) }}</td>
       <td class="num">${{ '%.4f'|format(t.cumulative_usd) }}</td>
       <td><div class="bar" style="width:{{ t.bar_pct }}%"></div></td>
     </tr>
     {% if t.discrepancy %}
     <tr><td></td><td colspan="7" class="warn">↳ meter discrepancy vs provider: {{ t.discrepancy }}</td></tr>
     {% endif %}
     {% if t.overshoot %}
     <tr><td></td><td colspan="7" class="warn">↳ cap enforced one hop late — no max_tokens declared</td></tr>
     {% endif %}
   {% endfor %}
   </tbody>
 </table>

 <p class="foot">run {{ r.run_id }} · generated by Breakerbox · projection = last-hop cost × remaining hops (naive linear; underestimates growing-context loops).</p>
</div></body></html>
